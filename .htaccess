# ==============================================================================
# OPTIMIZACIÓN DE CACHÉ DE NAVEGADOR (CACHE LIFETIMES) - DG AUDIOSOUND
# ==============================================================================

# 1. Habilitar Expiración de Caché (mod_expires)
<IfModule mod_expires.c>
    ExpiresActive On

    # Expiración por defecto: 1 mes
    ExpiresDefault "access plus 1 month"

    # HTML y datos dinámicos: No cachear o caché muy corta (validación inmediata)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"

    # Hojas de estilo y JavaScript: 1 año (ya que usamos nombres minificados/versionados)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Imágenes y recursos multimedia: 1 año
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Fuentes web: 1 año
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
</IfModule>

# 2. Configurar cabeceras Cache-Control explícitas (mod_headers) como respaldo
<IfModule mod_headers.c>
    # Recursos estáticos de larga duración (1 año)
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|mp4|webm)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # Recursos dinámicos (sin caché)
    <FilesMatch "\.(html|htm|xml|txt|json)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# 3. Compresión GZIP / Deflate para acelerar la transferencia de recursos
<IfModule mod_deflate.c>
    # Activar compresión
    SetOutputFilter DEFLATE
    
    # Tipos de archivo a comprimir
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Evitar problemas con navegadores antiguos
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
</IfModule>

# ==============================================================================
# URL REWRITING - OCULTAR EXTENSIÓN .HTML
# ==============================================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirigir externamente la URL con .html a la URL sin .html (SEO)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*)\.html\ HTTP [NC]
    RewriteRule ^(.*)\.html$ https://www.dgaudiosound.com/$1 [R=301,L]

    # 2. Reescritura interna: si la solicitud sin .html corresponde a un archivo .html existente, sírvelo
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]

    # ==============================================================================
    # 3. REDIRECCIONES 301 DE LA ESTRUCTURA ANTIGUA (/subpage/) A LA NUEVA
    # ==============================================================================
    # Residencial Premium
    RewriteRule ^subpage/soluciones/residencial-premium/?$ https://www.dgaudiosound.com/residencial-premium [R=301,L]
    RewriteRule ^subpage/cine_en_casa/?$ https://www.dgaudiosound.com/residencial-premium/cine-en-casa [R=301,L]
    RewriteRule ^subpage/applications/audio-distribuido/?$ https://www.dgaudiosound.com/residencial-premium/audio-distribuido [R=301,L]
    RewriteRule ^subpage/applications/audio-hi-fi/?$ https://www.dgaudiosound.com/residencial-premium/audio-hi-fi [R=301,L]
    RewriteRule ^subpage/applications/terrazas-y-jardin/?$ https://www.dgaudiosound.com/residencial-premium/terrazas-y-jardin [R=301,L]
    RewriteRule ^subpage/applications/family-room/?$ https://www.dgaudiosound.com/residencial-premium/family-room [R=301,L]
    RewriteRule ^subpage/applications/home-office/?$ https://www.dgaudiosound.com/residencial-premium/home-office [R=301,L]

    # Negocios y Experiencias
    RewriteRule ^subpage/soluciones/negocios-y-experiencias/?$ https://www.dgaudiosound.com/negocios-y-experiencias [R=301,L]
    RewriteRule ^subpage/applications/restaurantes/?$ https://www.dgaudiosound.com/negocios-y-experiencias/restaurantes [R=301,L]
    RewriteRule ^subpage/applications/bares-antros/?$ https://www.dgaudiosound.com/negocios-y-experiencias/bares-antros [R=301,L]
    RewriteRule ^subpage/applications/gimnasios/?$ https://www.dgaudiosound.com/negocios-y-experiencias/gimnasios [R=301,L]
    RewriteRule ^subpage/applications/cafeterias/?$ https://www.dgaudiosound.com/negocios-y-experiencias/cafeterias [R=301,L]
    RewriteRule ^subpage/applications/retail/?$ https://www.dgaudiosound.com/negocios-y-experiencias/retail [R=301,L]
    RewriteRule ^subpage/applications/barberias/?$ https://www.dgaudiosound.com/negocios-y-experiencias/barberias [R=301,L]

    # Corporativo e Institucional
    RewriteRule ^subpage/soluciones/corporativo-e-institucional/?$ https://www.dgaudiosound.com/corporativo-e-institucional [R=301,L]
    RewriteRule ^subpage/applications/salas-de-juntas/?$ https://www.dgaudiosound.com/corporativo-e-institucional/salas-de-juntas [R=301,L]
    RewriteRule ^subpage/applications/auditorios-corporativos/?$ https://www.dgaudiosound.com/corporativo-e-institucional/auditorios-corporativos [R=301,L]
    RewriteRule ^subpage/applications/educacion/?$ https://www.dgaudiosound.com/corporativo-e-institucional/educacion [R=301,L]
    RewriteRule ^subpage/applications/hoteles/?$ https://www.dgaudiosound.com/corporativo-e-institucional/hoteles [R=301,L]
    RewriteRule ^subpage/applications/oficinas-corporativas/?$ https://www.dgaudiosound.com/corporativo-e-institucional/oficinas-corporativas [R=301,L]
    RewriteRule ^subpage/applications/gobierno/?$ https://www.dgaudiosound.com/corporativo-e-institucional/gobierno [R=301,L]

    # Eventos y Producción
    RewriteRule ^subpage/soluciones/eventos-y-produccion/?$ https://www.dgaudiosound.com/eventos-y-produccion [R=301,L]
    RewriteRule ^subpage/applications/podcast/?$ https://www.dgaudiosound.com/eventos-y-produccion/podcast [R=301,L]
    RewriteRule ^subpage/applications/streamers/?$ https://www.dgaudiosound.com/eventos-y-produccion/streamers [R=301,L]
    RewriteRule ^subpage/applications/centros-de-culto/?$ https://www.dgaudiosound.com/eventos-y-produccion/centros-de-culto [R=301,L]
    RewriteRule ^subpage/applications/musicos-vocalistas/?$ https://www.dgaudiosound.com/eventos-y-produccion/musicos-vocalistas [R=301,L]
    RewriteRule ^subpage/applications/sonidos-dj/?$ https://www.dgaudiosound.com/eventos-y-produccion/sonidos-dj [R=301,L]
    RewriteRule ^subpage/applications/cine-independiente/?$ https://www.dgaudiosound.com/eventos-y-produccion/cine-independiente [R=301,L]

    # Páginas principales restantes
    RewriteRule ^subpage/soluciones/?$ https://www.dgaudiosound.com/soluciones [R=301,L]
    RewriteRule ^subpage/aplicaciones/?$ https://www.dgaudiosound.com/aplicaciones [R=301,L]
    RewriteRule ^subpage/?$ https://www.dgaudiosound.com/ [R=301,L]
</IfModule>
